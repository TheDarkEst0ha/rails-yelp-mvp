<div class="container bg-card border-end border-bottom rounded p-4 mt-3 mb-5 mx-1 col-lg-8">
  <div class="d-flex justify-content-between mb-3">
    <h3>Add restaurant</h3>
  </div>

    <%= simple_form_for(@restaurant, html: { class: 'd-flex flex-column gap-2'}) do |f| %>
        <div class="d-flex p-2 ">
            <%= f.label :name, class: 'col-sm-2 col-form-label' %>
            <%= f.input_field :name, class: 'w-100 form-control form-control-sm bg-input' %>
        </div>

        <div class="d-flex p-2">
            <%= f.label :address, class: "col-sm-2 col-form-label" %>
            <%= f.input_field :address, class: 'w-100 form-control form-control-sm bg-input' %>
        </div>

        <div class="row p-2 align-items-center">
            <div class="col-sm-2">
                <%= f.label :category, class: "col-form-label" %>
            </div>
            <div class="col-sm-4">
                <%= f.input_field :category, class: 'form-control form-control-sm bg-input' %>
            </div>

            <div class="col-sm-4 mx-3">
                <%= f.label :accepts_reservations, as: :boolean, boolean_style: :inline %>
                <%= f.collection_radio_buttons :accepts_reservations, [[true, 'Yes'], [false, 'No']], :first, :last,
                item_wrapper_class: 'form-check form-check-label',
                item_label_class: 'form-check-label'
                %>
            </div>
        </div>

        <div class="d-flex p-2">
            <%= f.label :phone_number, class: "col-sm-2 col-form-label" %>
            <%= f.input_field :phone_number, class: 'w-100 form-control form-control-sm bg-input' %>
        </div>


    <%= f.submit class: 'btn primary-btn mt-3' %>
    <% end %>
</div>
