<div class="container bg-card border-end border-bottom rounded p-4 mt-3 mb-5 col-12 col-md-10 col-lg-8">

  <div class="d-flex justify-content-between mb-3">
    <h3>Add restaurant</h3>
  </div>

  <%= simple_form_for(@restaurant, html: { class: 'row g-3' }) do |f| %>

    <div class="col-12">
      <%= f.label :name, class: 'form-label' %>
      <%= f.input_field :name, class: 'form-control form-control-sm bg-input' %>
    </div>

    <div class="col-12">
      <%= f.label :address, class: 'form-label' %>
      <%= f.input_field :address, class: 'form-control form-control-sm bg-input' %>
    </div>

    <div class="col-12 col-md-6">
      <%= f.label :category, class: 'form-label' %>
      <%= f.input_field :category, class: 'form-control form-control-sm bg-input' %>
    </div>

    <div class="col-12 col-md-6">
      <%= f.label :accepts_reservations, class: 'form-label d-block' %>

      <div class="d-flex gap-3 mt-1">
        <%= f.collection_radio_buttons :accepts_reservations,
          [[true, 'Yes'], [false, 'No']], :first, :last,
          item_wrapper_class: 'form-check',
          item_label_class: 'form-check-label' do |b| %>
            <div class="form-check">
              <%= b.radio_button(class: "form-check-input") %>
              <%= b.label(class: "form-check-label") %>
            </div>
        <% end %>
      </div>
    </div>

    <div class="col-12">
      <%= f.label :phone_number, class: "form-label" %>
      <%= f.input_field :phone_number, class: 'form-control form-control-sm bg-input' %>
    </div>

    <div class="col-12">
      <%= f.submit class: 'btn primary-btn mt-3 w-100 w-md-auto' %>
    </div>

  <% end %>

</div>
