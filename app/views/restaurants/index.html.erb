<div class="container p-4 my-3 mx-5">
  <h1>Restaurant List</h1>
  <%= link_to 'Add new restaurant', new_restaurant_path(@restaurant), class: 'btn btn-primary my-3' %>
  <% @restaurants.each do |restaurant| %>
    <div class="card d-flex border p-4 mb-5 mt-3">
        <h3 class="card-title"><%= restaurant.name %></h3>
        <p class="card-body" ><%= restaurant.address %> - <%=restaurant.category.capitalize %></p>
      <div class="container m-2">
        <%=link_to 'See details', restaurant_path(restaurant), class: 'btn btn-outline-primary d-md-block' %>
      </div>
    </div>
  <% end %>
</div>
