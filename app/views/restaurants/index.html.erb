<div class="container p-4 my-3 mx-5">
  <h1>Restaurant List</h1>
  <%= link_to 'Add new restaurant', '#collapseExample', class: 'btn primary-btn my-3', data: {bs_toggle: "collapse"} %>
  <div class="collapse" id="collapseExample" >
    <%= render "form" %>
  </div>
  
  <% @restaurants.each do |restaurant| %>
    <div class="card bg-card d-flex border p-4 mb-5 mt-3">
        <h3 class="card-title"><%= restaurant.name.capitalize %></h3>
        <p class="card-body" ><%= restaurant.address.capitalize %> - <%=restaurant.category.capitalize %></p>
      <div class="container m-2">
        <%=link_to 'See details', restaurant_path(restaurant), class: 'btn card-link d-md-block' %>
      </div>
    </div>
  <% end %>
</div>
