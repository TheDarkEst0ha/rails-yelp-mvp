<div class="container p-4 my-3">
  <h1 class="text-center text-md-start">Restaurant List</h1>

  <div class="d-flex justify-content-center justify-content-md-start">
    <%= link_to 'Add new restaurant', '#addRestaurant', 
      class: 'btn primary-btn my-3', data: { bs_toggle: "collapse" } %>
  </div>

  <!-- Form Collapse -->
  <div class="collapse" id="addRestaurant">
    <%= render "form" %>
  </div>

  <div class="row g-4 mt-2">
    <% @restaurants.each do |restaurant| %>
      <div class="col-12 col-md-6 col-lg-4">
        <div class="card bg-card border p-4 h-100">
          <h3 class="card-title"><%= restaurant.name.capitalize %></h3>

          <p class="card-body mb-3">
            <%= restaurant.address.capitalize %> - <%= restaurant.category.capitalize %>
          </p>

          <div class="mt-auto">
            <%= link_to 'See details', restaurant_path(restaurant),
              class: 'btn card-link w-100' %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
