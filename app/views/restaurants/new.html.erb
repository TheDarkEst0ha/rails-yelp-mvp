<div class="container">
  <h1>Add new restaurant</h1>
  <%= link_to 'Back', restaurants_path, class: 'btn btn-secondary' %>

    <%= simple_form_for(@restaurant) do |f| %>
      <%= f.input :name %>
      <%= f.input :address %>
      <%= f.input :category %>
      <%= f.submit class: 'btn btn-primary mt-3' %>
    <% end %>

</div>
