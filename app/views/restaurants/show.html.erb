<div class="container mx-5 my-3">
  <%= link_to 'Back', restaurants_path, class: 'btn btn-secondary' %>

  <div class="form-control p-4 m-3">
      <h1><%= @restaurant.name %></h1>
      <h5><%= @restaurant.address %> - <%= @restaurant.category.capitalize %></h5>
      <p><%= @restaurant.phone_number %></p>
      <h2>Reviews</h2>
      <% @restaurant.reviews.each do |review| %>
          <p class="lh-1"><%=  review.rating.to_f %></p>
          <p><%= review.content %></p>
      <% end %>

      <p class="mt-3">
        <%= link_to 'Add Review', new_restaurant_review_path(@restaurant), class: 'btn btn-primary'  %>
      </p>
  </div>
</div>
