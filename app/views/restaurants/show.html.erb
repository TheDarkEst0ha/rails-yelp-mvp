<div class="container p-4 my-3 mx-5">
  <div class="d-flex justify-content-between">
    <h2 class="pt-4">Overview</h2>
    <%= link_to 'Back', restaurants_path, class: 'btn btn-secondary my-auto' %>
  </div>

  <div class="form-control p-4 m-3">
      <h1><%= @restaurant.name %></h1>
      <h5><%= @restaurant.address %> - <%= @restaurant.category.capitalize %></h5>
      <div class="d-flex gap-5">
        <% if @restaurant.phone_number.present? %>
            <p class=" my-0">
              <i class="fa-solid fa-phone" style="color: #1d9134;"></i>- <%= @restaurant.phone_number %>
            </p>
        <% end %>

        <p class="mb-0">
          Reservations?
          <% if @restaurant.accepts_reservations %>
            <span class="text-success"><i class="fa-solid fa-check"></i> Yes</span>
          <% else %>
            <span class="text-danger"><i class="fa-solid fa-xmark"></i> No</span>
          <% end %>
        </p>
      </div>
  </div>

  <div class="p-4 m-3">
    <h2>Reviews</h2>
    <p class="mt-3">
      <%= link_to 'Add Review', "#test", class: 'btn primary-btn',  data: {bs_toggle: "collapse"}  %>
    </p>
    <div class="collapse" id="test">
      <%= render "reviews/form" %>
    </div>


    <% if @restaurant.reviews.any? %>
      <% @restaurant.reviews.each do |review| %>
         <% badge_color =
          if review.rating >= 4
            "bg-success"
          elsif review.rating >= 3
            "bg-warning text-dark"
          else
            "bg-danger"
          end
        %>

        <div class="bg-dark border rounded p-3 my-3 review-card">
          <p class="lh-1">
            <span class="badge <%= badge_color %>">
              <%= review.rating %> <i class="fa-solid fa-star"></i>
            </span>
            </p>  
            <p><%= review.content.capitalize %></p>

          <sub><i class="fa-solid fa-calendar pe-1" style="color: #B197FC;"></i> <span>Submitted on</span> <%= review.created_at.strftime("%d-%m-%Y") %> </sub>
        </div>
      <% end %>

    <% else %>
        <p class="pt-2 px-3">No reviews yet...</p>
    <% end %>
  </div>

</div>
