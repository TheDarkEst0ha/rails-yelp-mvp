<div class="container bg-card border-end border-bottom rounded p-4 mt-3 mb-5 mx-auto col-12 col-md-10 col-lg-8">

  <h4 class="mb-3">Add a review</h4>

  <%= simple_form_for [@restaurant, @review] do |f| %>

    <div class="row g-3 mb-3 align-items-center">
      <div class="col-12 col-sm-auto">
        <%= f.label :rating, class: 'col-form-label' %>
      </div>

      <div class="col-12 col-sm">
        <%= f.input :rating,
            label: false,
            input_html: { class: "rounded bg-input ps-2 w-100", min: 1, max: 5, step: 0.1 },
            hint: "Max rating is 5"
        %>
      </div>
    </div>

    <div class="mb-3">
      <%= f.input :content,
          label: "Content",
          input_html: { class: "form-control form-control-sm bg-input" }
      %>
    </div>

    <div class="mt-3">
      <%= f.submit "Create Review", class: 'btn primary-btn w-100 w-sm-auto' %>
    </div>

  <% end %>
</div>
